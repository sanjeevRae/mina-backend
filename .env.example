# Example .env file for Supabase configuration
# Copy this to .env and fill in your actual values

# ============================================
# SUPABASE DATABASE CONFIGURATION
# ============================================
# Get your connection string from Supabase dashboard:
# Settings → Database → Connection string → URI
# Replace [YOUR-PASSWORD] with your actual database password
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Alternative: Use DATABASE_URL (both work the same)
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# Debug mode (set to false in production)
DEBUG=true

# Environment
ENVIRONMENT=development

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# For caching and real-time features
# You can use a free Redis provider like Upstash or Redis Cloud
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============================================
# CLOUDINARY CONFIGURATION (Optional)
# ============================================
# For file storage - get free account at cloudinary.com
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_SECURE=true

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_VIDEO_CALLS=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
